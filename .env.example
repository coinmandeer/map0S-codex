# MapOS V3 — local development environment
# Copy to `.env` (git-ignored) and fill in what you need.
# Every key below is read by apps/api only — nothing is ever exposed to the browser.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://mapos:mapos@localhost:5434/mapos
PORT=4033

# Public API security. Dev defaults trust no proxy and allow only local Vite origins.
MAPOS_CORS_ORIGINS=
MAPOS_TRUSTED_PROXIES=
# Synthetic game credits only; never represents live money or custody.
MAPOS_PROTOTYPE_STAKING_ENABLED=
MAPOS_AI_GATEWAY_ENABLED=

# Guest-first linked identities. SIWE stays off until the deployment has an exact HTTPS origin.
# Chain 8453 is Base mainnet; chain 1 is retained for identity-only Ethereum signatures.
MAPOS_PUBLIC_ORIGIN=http://localhost:5173
MAPOS_SIWE_ENABLED=
MAPOS_SIWE_CHAIN_IDS=1,8453
# Optional Ethereum-mainnet RPC used only for cached ENS display metadata. No implicit public RPC.
MAPOS_ENS_RPC_URL=
# Explicit local/demo-only identity. Production additionally requires
# MAPOS_ALLOW_PRODUCTION_SIMULATION=1, so a single accidental flag cannot expose it.
MAPOS_IDENTITY_SIMULATION_ENABLED=
MAPOS_ALLOW_PRODUCTION_SIMULATION=
# Optional bearer token for redacted `/internal/metrics`; keep server-side only.
MAPOS_OPERATIONS_TOKEN=
# HMAC secret for distributed abuse-control buckets; raw client IPs are never persisted.
MAPOS_RATE_LIMIT_SECRET=local-development-rate-limit-secret

# Provider-neutral commerce core is always available, but checkout is disabled by default.
# The only implemented adapter is an offline synthetic fixture and is rejected in production.
MAPOS_COMMERCE_ENABLED=
MAPOS_COMMERCE_PROVIDER=none
MAPOS_SYNTHETIC_COMMERCE_ENABLED=
MAPOS_SYNTHETIC_COMMERCE_SECRET=

# ---------------------------------------------------------------------------
# Map data providers
# ---------------------------------------------------------------------------
# Mapy.com REST API — tiles, geocoding, suggest, routing, elevation.
# Get a key at https://developer.mapy.com (Basic plan = 250k credits/month free).
MAPY_API_KEY=

# ---------------------------------------------------------------------------
# Basemap tiles — every one of these is optional. Without a key the background is
# hidden from the picker rather than shown broken; the keyless ones (CARTO,
# OpenFreeMap, Sentinel-2, NASA, Esri) always work. Where to sign up, how much is
# free and which of them ask for a card: docs/basemaps.md
# ---------------------------------------------------------------------------
# 100k tile calls/month free, but the project needs billing enabled — set a daily
# quota in the console. https://console.cloud.google.com → Map Tiles API
GOOGLE_MAPS_API_KEY=
# ~30k transactions/month free; Base Plan asks for a card to verify identity.
HERE_API_KEY=
# 100k requests/month, no card. https://www.maptiler.com/cloud/
MAPTILER_API_KEY=
# 150k tiles/month on the Hobby plan, no card. https://www.thunderforest.com/pricing/
THUNDERFOREST_API_KEY=
# 200k credits/month for non-commercial use, no card. https://stadiamaps.com/
STADIA_API_KEY=
# 50k tiles/day free. https://developer.tomtom.com/
TOMTOM_API_KEY=
# 3k credits/day free. https://www.geoapify.com/
GEOAPIFY_API_KEY=

# Overpass mirrors, comma-separated, tried in order.
OVERPASS_URLS=https://overpass.openstreetmap.fr/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter

# ---------------------------------------------------------------------------
# Weather
# ---------------------------------------------------------------------------
# OpenWeatherMap tile overlays (precipitation/temp/wind/clouds/pressure).
OWM_API_KEY=
# Optional: Windy Map Forecast API. Unset = wind particles fall back to Open-Meteo.
WINDY_API_KEY=

# ---------------------------------------------------------------------------
# CML — the app's AI layer ("centrální mozek lidstva")
# ---------------------------------------------------------------------------
# Which provider CML routes through: ollama | openai | none
CML_PROVIDER=ollama
# Ollama Cloud (OpenAI-compatible endpoint).
# Models get retired on a few months' notice — a retired one answers 410 on every call. Ask
# `curl -H "Authorization: Bearer $OLLAMA_API_KEY" https://ollama.com/v1/models` what's live.
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=glm-5.3-flash
# Two model slots the AI router picks between. `fast` answers routing, suggest and short
# summaries; `strong` handles guide synthesis, plan proposals and generated layers. Both fall
# back to OLLAMA_MODEL when unset.
OLLAMA_MODEL_FAST=glm-5.3-flash
OLLAMA_MODEL_STRONG=deepseek-v4-pro:0813
# OpenAI slot — used when CML_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Park4Night
# ---------------------------------------------------------------------------
# Prototype operator switch. Source-rights metadata is advisory and does not hide the layer.
PARK4NIGHT_ENABLED=1

# ---------------------------------------------------------------------------
# Optional enrichment
# ---------------------------------------------------------------------------
# Foursquare — pin photos, ratings and tips.
FSQ_API_KEY=

# Identifies this deployment to Nominatim, Overpass and the Wikimedia APIs, which
# require it and rate-limit anonymous traffic as one bucket. An email or project URL.
MAPOS_CONTACT=

# ---------------------------------------------------------------------------
# Optional layers — each needs a free key, each is simply hidden without one.
# Sign-up links and what the data is good for: docs/data-sources.md
# ---------------------------------------------------------------------------
# EV charging stations — https://openchargemap.org/site/develop/api
OPENCHARGEMAP_API_KEY=
# Street-level imagery — https://www.mapillary.com/dashboard/developers
MAPILLARY_ACCESS_TOKEN=
# Satellite fire detections — https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=
# Reference air quality stations — https://explore.openaq.org/register
OPENAQ_API_KEY=
# Recent bird sightings — https://ebird.org/api/keygen
EBIRD_API_TOKEN=
# Events for the Discover timeline — https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=
# Tourist POIs with a notability rating — https://dev.opentripmap.org/product
# ODbL data, 5 000 requests/day. Free tier is non-commercial, so the ranking works without it.
OPENTRIPMAP_API_KEY=

# Opencaching — geocaches as quest anchors in the game layer. The network is federated,
# so keys are per country; DE (which also covers IT and FR) and PL cover most of Europe.
# Sign-up form: https://www.opencaching.de/okapi/signup.html (same path on each instance).
OKAPI_KEY_DE=
OKAPI_KEY_PL=
OKAPI_KEY_NL=
OKAPI_KEY_UK=
OKAPI_KEY_US=

# ---------------------------------------------------------------------------
# Frontend build args (apps/web)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api
# Emergency compatibility rollbacks; unset means the v2 composition is enabled.
VITE_APP_SHELL_V2=
VITE_DETAIL_SURFACE_V2=
# Revert only the Phase 16 avatar/inventory surface; orbs, quests and zones remain active.
VITE_GAME_AVATAR_V2=
# Revert only the Phase 18 shared registry/style lifecycle; data and legacy handles stay intact.
VITE_MAP_RUNTIME_V2=
