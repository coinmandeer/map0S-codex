# MapOS V3 — local development environment
# Copy to `.env` (git-ignored) and fill in what you need.
# Every key below is read by apps/api only — nothing is ever exposed to the browser.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://mapos:mapos@localhost:5434/mapos
PORT=4033

# ---------------------------------------------------------------------------
# Map data providers
# ---------------------------------------------------------------------------
# Mapy.com REST API — tiles, geocoding, suggest, routing, elevation.
# Get a key at https://developer.mapy.com (Basic plan = 250k credits/month free).
MAPY_API_KEY=

# Overpass mirrors, comma-separated, tried in order.
OVERPASS_URLS=https://overpass.openstreetmap.fr/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass-api.de/api/interpreter

# ---------------------------------------------------------------------------
# Weather
# ---------------------------------------------------------------------------
# OpenWeatherMap tile overlays (precipitation/temp/wind/clouds/pressure).
OWM_API_KEY=
# Optional: Windy Map Forecast API. Unset = wind particles fall back to Open-Meteo.
WINDY_API_KEY=

# ---------------------------------------------------------------------------
# CML — the app's AI layer ("centrální mozek lidstva")
# ---------------------------------------------------------------------------
# Which provider CML routes through: ollama | openai | none
CML_PROVIDER=ollama
# Ollama Cloud (OpenAI-compatible endpoint).
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v3.1:671b
# OpenAI slot — used when CML_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Optional enrichment
# ---------------------------------------------------------------------------
# Foursquare — pin photos, ratings and tips.
FSQ_API_KEY=

# Identifies this deployment to Nominatim, Overpass and the Wikimedia APIs, which
# require it and rate-limit anonymous traffic as one bucket. An email or project URL.
MAPOS_CONTACT=

# ---------------------------------------------------------------------------
# Optional layers — each needs a free key, each is simply hidden without one.
# Sign-up links and what the data is good for: docs/data-sources.md
# ---------------------------------------------------------------------------
# EV charging stations — https://openchargemap.org/site/develop/api
OPENCHARGEMAP_API_KEY=
# Street-level imagery — https://www.mapillary.com/dashboard/developers
MAPILLARY_ACCESS_TOKEN=
# Satellite fire detections — https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=
# Reference air quality stations — https://explore.openaq.org/register
OPENAQ_API_KEY=
# Recent bird sightings — https://ebird.org/api/keygen
EBIRD_API_TOKEN=
# Events for the Discover timeline — https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# ---------------------------------------------------------------------------
# Frontend build args (apps/web)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=/api
