POSTGRES_PASSWORD=change-me-in-production
IMAGE_TAG=latest
# The deploy script replaces this with the immutable release tag before startup.
MAPOS_RELEASE=local-production
MAPOS_MIGRATION_ACTOR=mapos-api

# Exact comma-separated origins allowed to make credentialed cross-origin browser requests.
# Same-origin /api calls need no entry. Never use * together with session cookies.
MAPOS_CORS_ORIGINS=
# Trusted reverse-proxy address ranges. Address/CIDR based only; numeric hop counts are rejected.
MAPOS_TRUSTED_PROXIES=loopback,linklocal,uniquelocal
# Synthetic game credits only. Leave disabled in production.
MAPOS_PROTOTYPE_STAKING_ENABLED=
# External model calls remain disabled until privacy/source gates are reviewed.
MAPOS_AI_GATEWAY_ENABLED=

# Exact public HTTPS origin used in the signed SIWE challenge.
MAPOS_PUBLIC_ORIGIN=https://mapos.example
MAPOS_SIWE_ENABLED=
MAPOS_SIWE_CHAIN_IDS=1,8453
# Optional Ethereum-mainnet RPC used only for cached ENS display metadata.
MAPOS_ENS_RPC_URL=
# Keep both unset in real production. They exist only for clearly labelled demo identities.
MAPOS_IDENTITY_SIMULATION_ENABLED=
MAPOS_ALLOW_PRODUCTION_SIMULATION=
# Random 32+ character bearer token for the redacted operations endpoint.
MAPOS_OPERATIONS_TOKEN=
# Independent random 32+ character HMAC secret; raw client IPs are never persisted.
MAPOS_RATE_LIMIT_SECRET=
# No real payment provider has passed the use-case/legal gate. Keep checkout disabled.
MAPOS_COMMERCE_ENABLED=
MAPOS_COMMERCE_PROVIDER=none

# OpenWeatherMap tile overlays (temp/wind/clouds/pressure) — https://openweathermap.org/api
OWM_API_KEY=

# Mapy.com REST API — tiles, geocoding, suggest, routing, elevation.
# https://developer.mapy.com — Basic plan is 250k credits/month free.
MAPY_API_KEY=

# CML (AI layer). Provider: ollama | openai | none
CML_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4-flash:0731

# Optional. Without these keys, pin photos/reviews, AI summaries and wind particles
# degrade gracefully instead of failing.
FSQ_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WINDY_API_KEY=

# Identifies this deployment to Nominatim, Overpass and Wikimedia, which rate-limit by
# User-Agent and block generic ones. An e-mail or a URL.
MAPOS_CONTACT=

# Prototype operator switch. Source-rights metadata is advisory and does not hide the layer.
PARK4NIGHT_ENABLED=1

# Optional sources. Empty keys leave these providers unavailable.
OPENCHARGEMAP_API_KEY=
NASA_FIRMS_MAP_KEY=
OPENAQ_API_KEY=
EBIRD_API_TOKEN=
TICKETMASTER_API_KEY=

# Tiles remain disabled until the provider account's free capacity is verified and a
# provider_budget allocation is installed for this account. Never enable paid fallback.
MAPY_BUDGET_ACCOUNT=
# Optional Places UI Kit: separate public key restricted to deployed origins and Places UI.
# Set to 1 only after a HARD provider quota below free capacity is verified; budgets/alerts do not suffice.
GOOGLE_PLACES_BROWSER_KEY=
GOOGLE_PLACES_FREE_CAP_VERIFIED=0
# Only after verifying the billing account remains Free Trial (no automatic paid upgrade).
# ISO timestamp before trial expiry; leave empty on a paid account.
GOOGLE_PLACES_TRIAL_VERIFIED_UNTIL=
GOOGLE_MAPS_API_KEY=
GOOGLE_TILES_ENABLED=0
GOOGLE_BUDGET_ACCOUNT=
# Keep 0 for EEA accounts unless satellite availability was explicitly verified.
GOOGLE_SATELLITE_ENABLED=0

# Direct browser geocoding fallback: verify project quota blocks overage, including map requests.
MAPTILER_FREE_CAP_VERIFIED=0

# Use provider only when external providers enforce the account limits.
# Google always requires a verified allocation, regardless of this setting.
MAPOS_PROVIDER_BUDGET_MODE=allocation

# Optional server-only data providers
GOLEMIO_API_KEY=
EUROPEANA_API_KEY=
