    "override": { "schemaVersion": "3.0.0" }
  },
  {
    "id": "sdk-exact-v3",
    "expectedCode": "UNSUPPORTED_SDK_RANGE",
    "override": { "sdkRange": "v3" }
  },
  {
    "id": "sdk-caret-v3",
    "expectedCode": "UNSUPPORTED_SDK_RANGE",
    "override": { "sdkRange": "^3" }
  },
  {
    "id": "minimum-runtime-newer-than-host",
    "expectedCode": "MINIMUM_RUNTIME_NOT_MET",
