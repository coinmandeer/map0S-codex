      "source": {
        "type": "declarative-http",
        "endpoint": "https://data.example.test/points",
        "method": "GET",
        "requiresServerProxy": true,
        "responseAdapter": "execute-partner-code",
        "mapping": {
          "idPath": "id",
          "titlePath": "name",
          "longitudePath": "lng",
          "latitudePath": "lat"
        }
      }
    }
