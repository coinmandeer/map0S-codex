        {
          "id": "character",
          "title": "O místě",
          "claims": [
            {
              "id": "claim:wiki:0622d3122a6a850cd58cbb7a3dfb746bb56cf9b375a40e4f2be2b37be3d4945a",
              "text": "Leží mírně na sever od středu Čech na řece Vltavě. Praha se rozkládá na území 496 km² a žije zde okolo 1,4 milionu obyvatel, v pražské metropolitní oblasti žije zhruba 2,1 milionu obyvatel. Praha je jedním z krajů a zároveň správním centrem Středočeského kraje, který ji obklopuje. V Praze se koncentruje většina státních institucí, sídlí zde prezident republiky, parlament, vláda, ústřední státní orgány a vrchní soud. Hlavní město je také ekonomickým, výzkumným, kulturním a náboženským centrem země.",
              "evidenceIds": [
                "wiki:0622d3122a6a850cd58cbb7a3dfb746bb56cf9b375a40e4f2be2b37be3d4945a"
