{
  "name": "@mapos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:memory": "tsx watch src/memory-server.ts",
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-ai-assets.mjs",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "geo:units": "tsx src/geo/importGeoUnits.ts",
    "stats:import": "tsx src/themes/importStatSeries.ts",
    "stats:report": "tsx src/themes/statisticsReport.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.3.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@mapos/adapter-sdk": "*",
    "@mapos/layer-sdk": "*",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.4.0",
    "geojson-vt": "^4.0.3",
    "meshoptimizer": "^1.2.0",
    "nanoid": "^5.1.5",
    "postgres": "^3.4.7",
    "sharp": "^0.35.4",
    "viem": "^2.55.19",
    "vt-pbf": "^3.1.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^2.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.3",
    "@types/ws": "^8.18.1",
    "pbf": "^4.0.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
