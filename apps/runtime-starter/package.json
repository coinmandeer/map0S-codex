    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mapos/layer-sdk": "*",
    "@mapos/map-runtime": "*",
    "maplibre-gl": "^5.6.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
