{
  "name": "@mapos/runtime-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "predev": "npm run build -w @mapos/layer-sdk && npm run build -w @mapos/map-runtime",
